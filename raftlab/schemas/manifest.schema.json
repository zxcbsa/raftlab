{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raftlab.local/schemas/manifest.schema.json",
  "title": "Run manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "createdAt", "scenario", "seed", "host", "build", "cluster", "tool"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9][a-z0-9-]{0,63}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "scenario": {
      "type": "object",
      "required": ["name", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "seed": { "type": "integer", "minimum": 0 },
    "host": {
      "type": "object",
      "required": ["hostname", "os", "cpuCores", "memTotalMB"],
      "additionalProperties": false,
      "properties": {
        "hostname": { "type": "string" },
        "os": { "type": "string" },
        "cpuCores": { "type": "integer", "minimum": 1 },
        "memTotalMB": { "type": "integer", "minimum": 1 }
      }
    },
    "build": {
      "type": "object",
      "required": ["type", "gitCommit", "gitDirty"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["Release", "Debug"] },
        "gitCommit": { "type": "string" },
        "gitDirty": { "type": "boolean" },
        "compiler": { "type": "string" },
        "protobuf": { "type": "string" }
      }
    },
    "cluster": {
      "type": "object",
      "required": ["nodes", "maxRaftState", "logLevel"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "integer", "minimum": 2, "maximum": 9 },
        "maxRaftState": { "type": "integer", "minimum": 0 },
        "logLevel": { "enum": ["off", "info", "debug"] },
        "basePort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
